# ============================================================
# .env.example
# ------------------------------------------------------------
# This is the PUBLIC template of the environment variables the
# project needs. Copy it to `.env` locally and fill in real
# values. NEVER commit the real `.env` file.
#
#   cp .env.example .env
#
# All values below are PLACEHOLDERS for local development only.
# Non-standard ports are intentional (security best practice).
# ============================================================

# --- Server ---
# Connection string for PostgreSQL.
# NOTE: host port 5442 is non-standard (container maps 5442 -> 5432).
DATABASE_URL=postgres://nova:devpass@localhost:5442/nova

# Secret used to sign session tokens. Use a long random string in dev.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_in_production

# Port the NestJS backend listens on (non-standard, not 3000).
PORT=3210

# Origin allowed to call the API (CORS). In dev it is the Vite server.
CORS_ORIGIN=http://localhost:1420

# --- Redis (optional, for presence) ---
# NOTE: host port 6389 is non-standard (container maps 6389 -> 6379).
REDIS_URL=redis://localhost:6389

# --- App ---
# URL of the backend API (used by the desktop app).
VITE_API_URL=http://localhost:3210
